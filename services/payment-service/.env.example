# Payment 로컬 실행용(local 프로필). 이 파일을 같은 폴더에 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
#   cp services/payment-service/.env.example services/payment-service/.env
# 형식: KEY=value (따옴표·export 없이). 값이 없는 줄은 지우거나 비워 둔다.

# Commerce → Payment 서비스 토큰. 32자 이상. 로컬에서는 아무 값이나 같은 값을 호출 쪽에도 쓴다.
COMMERCECORE_PAYMENT_SERVICE_TOKEN=local-payment-token-change-me-0123456789

# 토스 API 주소. 주석으로 두면 실제 토스(https://api.tosspayments.com). 빈 값(KEY=)으로 두면 기동이 실패한다.
# 가짜 토스(WireMock)로 실패 경로를 볼 때만 주석을 푼다.
# PAYMENT_TOSS_BASE_URL=http://localhost:18080

# 토스 개발자센터 > API 키 > "API 개별 연동 키"의 테스트 시크릿 키(test_sk_...). 비우면 기동은 하고 토스 호출은 NotSent.
PAYMENT_TOSS_SECRET_KEY=

# 같은 "API 개별 연동 키"의 테스트 클라이언트 키(test_ck_...). 서버는 쓰지 않는다. 결제창 테스트 페이지가 쓴다.
PAYMENT_TOSS_CLIENT_KEY=
